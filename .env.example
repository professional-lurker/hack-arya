# AI Sandbox — Environment Configuration
# Copy this file to .env.local and fill in your values

# ─── DATABASE ───────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_sandbox"

# ─── AUTHENTICATION ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Or online: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="your-super-secret-nextauth-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ─── ENCRYPTION ─────────────────────────────────────────────
# AES-256 key for encrypting provider credentials at rest
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your-32-byte-hex-encryption-key-here"

# ─── REDIS (optional, falls back to in-memory) ───────────────
# Leave empty to use in-memory rate limiting (dev mode)
REDIS_URL=""
# REDIS_URL="redis://localhost:6379"

# ─── AI PROVIDERS ────────────────────────────────────────────
# Google Gemini - https://makersuite.google.com/app/apikey
GEMINI_API_KEY=""

# OpenWeather - https://openweathermap.org/api
OPENWEATHER_API_KEY=""

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Anthropic - https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Mistral - https://console.mistral.ai/
MISTRAL_API_KEY=""

# ─── APP CONFIG ──────────────────────────────────────────────
NODE_ENV="development"
# Set to "true" to enable mock providers (no real API keys needed)
ENABLE_MOCK_PROVIDERS="true"
# Set to "true" to seed demo data on startup
SEED_DEMO_DATA="true"
# Admin seed user (created on first run if SEED_DEMO_DATA=true)
ADMIN_EMAIL="admin@aisandbox.dev"
ADMIN_PASSWORD="Admin@123!"

# ─── SPENDING PROTECTION ─────────────────────────────────────
# Maximum daily spend across all providers (USD)
MAX_DAILY_SPEND_USD="10.00"
# Maximum hourly spend across all providers (USD)
MAX_HOURLY_SPEND_USD="2.00"
# Alert email for budget warnings (optional)
ADMIN_ALERT_EMAIL=""

# ─── SECURITY ────────────────────────────────────────────────
# Maximum temporary keys per user at once
MAX_ACTIVE_KEYS_PER_USER="5"
# Maximum keys created per user per day
MAX_DAILY_KEYS_PER_USER="10"
# Maximum requests per user per minute (global)
MAX_REQUESTS_PER_USER_PER_MINUTE="20"
# Maximum requests per IP per hour
MAX_REQUESTS_PER_IP_PER_HOUR="100"

# ─── LOGGING ─────────────────────────────────────────────────
# Store prompt previews in request logs (first 200 chars)
STORE_PROMPT_PREVIEWS="false"
# Request log retention in days
LOG_RETENTION_DAYS="30"
